# ==========================================
# YOUTUBE FACELESS AI ENGINE - ENVIRONMENT VARIABLES
# ==========================================

# Server Configuration
PORT=3001
NODE_ENV=production

# Google Gemini API Key (Gemini 2.0 Flash for Scripting & SEO)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 Key (Channel Tracking & Viral Outlier Detection)
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here

# Supabase / PostgreSQL Database Connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Stripe Gateway Credentials
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# App URL Configuration
PUBLIC_APP_URL=http://localhost:5173
